# Copy to .env and replace the secrets:  cp .env.example .env
# .env is git-ignored and excluded from the Docker build context (.dockerignore).

# --- application (FastAPI, read by src/config.py) ---
ENVIRONMENT=sandbox
DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# --- PostgreSQL (postgres:16-alpine reads these on first start of an empty volume) ---
POSTGRES_USER=portal
# URL-safe characters only: it is embedded in DATABASE_URL
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=portal_db

# docker-compose.yml builds DATABASE_URL for the web container from POSTGRES_* above
# (postgresql+asyncpg://USER:PASSWORD@db:5432/DB). Set it here only for running the app
# outside Docker; without it the app falls back to local SQLite.
# DATABASE_URL=postgresql+asyncpg://portal:password@localhost:5432/portal_db

# --- web container ---
# host port published for the API
WEB_PORT=8000
# gunicorn worker processes
WEB_CONCURRENCY=2
LOG_LEVEL=info

# --- optional Django dashboard (docker compose --profile client up) ---
FASTAPI_BACKEND_URL=http://web:8000
